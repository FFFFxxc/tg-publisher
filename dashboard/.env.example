# Control API воркера tg-publisher (HTTPS-адрес, который проксируется на 127.0.0.1:8081 сервера)
PUBLISHER_API_URL=https://your-control-api-host
# Bearer-токен = CONTROL_API_TOKEN из .env воркера. Хранится только на сервере Next.js.
PUBLISHER_API_TOKEN=change-me

# Опционально: basic-auth на саму панель (если не защищаете её иначе, например Vercel SSO)
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
