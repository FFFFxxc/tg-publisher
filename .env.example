# ПЛЕЙСХОЛДЕРЫ — реальные значения держи только в .env (он в .gitignore).
# Telegram API: https://my.telegram.org -> API development tools
TG_API_ID=12345678
TG_API_HASH=put-your-api-hash-here
# Твой канал, куда постим (юзербот должен быть там админом)
TG_DESTINATION=-100xxxxxxxxxx
# Источники через запятую (потом можно добавлять через панель)
TG_SOURCES=@channel1,@channel2

# Актив дополнительными user-аккаунтами: реакция, период проверки и число последних постов.
# Аккаунты добавляются в панели по номеру и коду, отдельные сессии лежат в appdata.
ACTIVITY_REACTION=👍
ACTIVITY_INTERVAL_SEC=30
ACTIVITY_RECENT_LIMIT=20

# SOCKS5 для Telegram на VK Cloud (оставь пустым, если Telegram доступен напрямую)
TG_PROXY_HOST=127.0.0.1
TG_PROXY_PORT=1080

POSTGRES_PASSWORD=change-me-strong-password

# Порядок слотов и время публикаций (МСК). Дальше можно менять через панель без рестарта.
SCHEDULE_PATTERN=parsed,old,parsed,old
PUBLISH_TIMES=09:00,12:00,15:00,18:00,21:00

# AI-подписи: есть ключ = включено, пусто = выключено. Ключ меняется только здесь (ENV).
AI_BASE_URL=https://api.example.com/v1
AI_API_KEY=sk-your-ai-key
AI_MODEL=gpt-4o-mini
AI_PROMPT=Перепиши подпись к посту для Telegram-канала: коротко и живо. Убери ссылки, упоминания и призывы подписаться на источник. Верни только текст.
AI_REQUIRED=false
AI_TIMEOUT_SEC=40

# --- Панель управления ---
# Control API слушает этот порт (host network: доступен на самом сервере как 127.0.0.1:8081)
CONTROL_API_PORT=8081
# Bearer-токен панели. ОБЯЗАТЕЛЬНО длинный случайный. Без него Control API не стартует.
CONTROL_API_TOKEN=change-me-long-random
# Изоляция БД: все таблицы проекта только в этой схеме, schema public старого cross не трогается
DB_SCHEMA=tg_publisher
